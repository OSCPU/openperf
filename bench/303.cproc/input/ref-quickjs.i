        return lre_is_id_start(c);



    }
}

static inline int lre_js_is_ident_next(uint32_t c) {
    if (c < 128) {
        return lre_is_id_continue_byte(c);
    } else {

        if (c >= 0x200C && c <= 0x200D)
            return TRUE;

        return lre_is_id_continue(c);



    }
}
